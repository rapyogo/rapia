# Template des variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs.
# .env.local n'est jamais commité ; les valeurs réelles vivent chez Vercel.

# --- Emails (Brevo SMTP + Nodemailer) ---
# Tous les envois passent par lib/email.ts. Sans ces six variables, le
# formulaire de contact répond 500 : rien n'est envoyé en silence.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_PASSWORD=
IA_FROM_EMAIL=ia@rapyogo.com
IA_FROM_NAME=RapIA

# --- Base de données Neon (Postgres serverless) ---
# Espace client : comptes, audits de workflow, formations, projets, blog,
# communautés, forum, quiz, newsletter.
DATABASE_URL="postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require&channel_binding=require"

# --- Site ---
# Facultatif : sert aux previews. En son absence, lib/site.ts applique
# https://ia.rapyogo.com — la valeur de production.
NEXT_PUBLIC_SITE_URL=
