# Template des variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs

# Resend API key pour l'envoi d'emails
# Sans cette clé, les messages du formulaire de contact seront loggés en console
RESEND_API_KEY=
CONTACT_EMAIL=contact@rapyogo.com

# Base de données Neon (Postgres serverless)
# Espace client : comptes, audits de workflow, formations, projets, blog, newsletter.
# La valeur réelle est dans .env.local (jamais commitée) et chez Vercel.
DATABASE_URL="postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require&channel_binding=require"
